# Configurazione client (Vite). Copiare in .env e compilare.
# NB: solo variabili NON sensibili — finiscono nel bundle del browser.
# La service role key NON va MAI qui: vive solo nella Edge Function
# admin-users (variabile SUPABASE_SERVICE_ROLE_KEY, iniettata da Supabase).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# --- Variabili delle Serverless Function Vercel (api/*) -------------
# Si impostano su Vercel → Project Settings → Environment Variables.
# Non vanno nel bundle browser (niente prefisso VITE_).

# PRESENZE_API_TOKEN          # token Bearer per /api/presenze (chiamato da Elledue cron)
# SUPABASE_URL                # URL del progetto Supabase (stesso valore di VITE_SUPABASE_URL)
# SUPABASE_SERVICE_ROLE_KEY   # service role Supabase, server-side only


# --- Secret delle Edge Functions Supabase ---------------------------
# NON vanno in .env (non servono al bundle browser): si impostano con
#   supabase secrets set NOME=valore
# Qui elencati solo come promemoria del contratto.

# ANTHROPIC_API_KEY           # preventivi-da-email, preventivi-rigenera-bozza
# AI_MODEL_ESTRAZIONE         # opzionale, default: claude-haiku-5-5
# AI_MODEL_BOZZA              # opzionale, default: claude-sonnet-5-5
# PREVENTIVI_WEBHOOK_SECRET   # preventivi-da-email, chiave hand-shake con Make
# PREVENTIVI_CRON_SECRET      # preventivi-cron, chiave hand-shake con Make
# TELEGRAM_BOT_TOKEN          # preventivi-cron + notify-order
# TELEGRAM_CHAT_ID            # idem
# APP_URL                     # opzionale, default: https://co.aschotel.com
